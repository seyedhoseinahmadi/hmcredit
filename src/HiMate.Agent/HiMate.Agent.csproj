<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>HiMate.Credit</AssemblyName>
    <RootNamespace>HiMate.Agent</RootNamespace>
    <Title>HiMate Credit</Title>
    <Product>HiMate Credit</Product>
    <Description>HiMate Credit Windows application</Description>
    <Company>HiMate</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>HiMate.ico</ApplicationIcon>
    <HiMateIconBase64></HiMateIconBase64>
    <Version>0.2.10</Version>
    <FileVersion>0.2.10.0</FileVersion>
    <AssemblyVersion>0.2.10.0</AssemblyVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <Target Name="GenerateHiMateIcon" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <HiMateGeneratedIcon>$(MSBuildProjectDirectory)\HiMate.ico</HiMateGeneratedIcon>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;[IO.File]::WriteAllBytes('$(HiMateGeneratedIcon)', [Convert]::FromBase64String('$(HiMateIconBase64)'))&quot;" />
  </Target>
</Project>
