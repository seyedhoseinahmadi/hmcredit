<Window x:Class="HiMate.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HiMate Agent" Height="780" Width="1220" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="20" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="HiMate" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="Windows Agent" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Button Style="{StaticResource NavButton}" Content="داشبورد" Click="ShowDashboard_Click" />
          <Button Style="{StaticResource NavButton}" Content="تراکنش‌ها" Click="ShowTransactions_Click" />
          <Button Style="{StaticResource NavButton}" Content="دستورات سرور" Click="ShowCommands_Click" />
          <Button Style="{StaticResource NavButton}" Content="تنظیمات" Click="ShowSettings_Click" />
          <Button Style="{StaticResource NavButton}" Content="لاگ" Click="ShowLogs_Click" />
        </StackPanel>
        <StackPanel Grid.Row="3">
          <TextBlock x:Name="SideDevice" Text="Device: -" Foreground="{StaticResource Muted}" Margin="0,0,0,5" />
          <TextBlock x:Name="SideVersion" Text="Agent 0.1.0" Foreground="{StaticResource Muted}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
            <Border Background="{StaticResource Panel2}" Padding="10,6" Margin="0,0,8,0">
              <TextBlock x:Name="SerialBadge" Text="SERIAL OFFLINE" Foreground="{StaticResource Bad}" FontWeight="SemiBold" />
            </Border>
            <Border Background="{StaticResource Panel2}" Padding="10,6">
              <TextBlock x:Name="ServerBadge" Text="SERVER UNKNOWN" Foreground="{StaticResource Warn}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="ConnectButton" Style="{StaticResource SecondaryButton}" Content="اتصال دستگاه" Click="ConnectButton_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="Sync Now" Click="SyncNow_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed" />
          </Style>
        </TabControl.Resources>

        <TabItem Header="Dashboard">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="داشبورد" FontSize="28" FontWeight="Bold" Margin="0,0,0,18" />
              <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="رویدادهای منتظر Sync" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="PendingCountText" Text="0" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="پورت دستگاه" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="PortText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
                  <StackPanel>
                    <TextBlock Text="HiMate Core" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="CoreVersionText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,0,0,18">
                <StackPanel>
                  <TextBlock Text="کنترل دستگاه" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                  <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="EVENTS" Click="RequestEvents_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="GETDEBIT" Click="GetDebit_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="STATUS" Click="Status_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="BALANCE" Click="Balance_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
                <StackPanel>
                  <TextBlock Text="وضعیت فاز فعلی" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                             Text="Sync رویدادهای ISSUE / ADD / DEBIT با HiMate Core 2.2 فعال است. دریافت Command از سرور پیاده‌سازی شده، اما اعمال خودکار CREDIT سروری تا زمانی که Firmware از CID+UID در خود دستور پشتیبانی نکند عمداً غیرفعال است." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Transactions">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="تراکنش‌ها" FontSize="28" FontWeight="Bold" />
              <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="بروزرسانی" Click="RefreshTransactions_Click" />
            </Grid>
            <DataGrid x:Name="EventsGrid" Grid.Row="2">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Local" Binding="{Binding LocalId}" Width="60" />
                <DataGridTextColumn Header="ID" Binding="{Binding DeviceEventId}" Width="70" />
                <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="150" />
                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="80" />
                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="80" />
                <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="70" />
                <DataGridTextColumn Header="REMAIN" Binding="{Binding Remaining}" Width="80" />
                <DataGridTextColumn Header="TX" Binding="{Binding Tx}" Width="60" />
                <DataGridTextColumn Header="GEN" Binding="{Binding Gen}" Width="80" />
                <DataGridTextColumn Header="SEQ" Binding="{Binding Seq}" Width="60" />
                <DataGridTextColumn Header="CID" Binding="{Binding Cid}" Width="70" />
                <DataGridTextColumn Header="SYNC" Binding="{Binding SyncStatus}" Width="95" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="Commands">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="دستورات سرور" FontSize="28" FontWeight="Bold" />
              <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="دریافت" Click="RefreshCommands_Click" />
            </Grid>
            <Border Grid.Row="2" Background="#2A2112" BorderBrush="#5A4320" BorderThickness="1" Padding="12">
              <TextBlock Foreground="#FFD48A" TextWrapping="Wrap"
                         Text="برای جلوگیری از شارژ کارت اشتباه، CREDIT سروری در این نسخه فقط نمایش داده می‌شود. اعمال آن بعد از ارتقای Firmware به CREDIT|CID=...|UID=...|AMOUNT=... فعال می‌شود." />
            </Border>
            <DataGrid x:Name="CommandsGrid" Grid.Row="4">
              <DataGrid.Columns>
                <DataGridTextColumn Header="CID" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="100" />
                <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="170" />
                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="90" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="Settings">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Right">
              <TextBlock Text="تنظیمات Agent" FontSize="28" FontWeight="Bold" Margin="0,0,0,18" />
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Server URL" VerticalAlignment="Center" />
                  <TextBox x:Name="ServerUrlBox" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="Device Code" VerticalAlignment="Center" />
                  <TextBox x:Name="DeviceCodeBox" Grid.Row="2" Grid.Column="1" />
                  <TextBlock Grid.Row="4" Text="Device Secret" VerticalAlignment="Center" />
                  <PasswordBox x:Name="DeviceSecretBox" Grid.Row="4" Grid.Column="1" />
                  <TextBlock Grid.Row="6" Text="COM Port" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="ComPortBox" Width="180" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Click="RefreshPorts_Click" />
                  </StackPanel>
                  <TextBlock Grid.Row="8" Text="Baud" VerticalAlignment="Center" />
                  <TextBox x:Name="BaudBox" Grid.Row="8" Grid.Column="1" Text="115200" Width="180" HorizontalAlignment="Right" />
                  <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource PrimaryButton}" Content="ذخیره تنظیمات" Click="SaveSettings_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="تست سرور" Click="TestServer_Click" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Logs">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="لاگ Agent" FontSize="28" FontWeight="Bold" />
            <ListBox x:Name="LogsList" Grid.Row="2" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
