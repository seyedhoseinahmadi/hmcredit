<Window x:Class="HiMate.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HiMate Credit" Height="790" Width="1180" MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource Bg}">
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="108" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Header}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="28,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="58" />
          <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="HiMate" FontFamily="Segoe UI" FontSize="34" FontWeight="Bold" Margin="0,0,8,0" />
            <TextBlock Text="Credit" FontFamily="Segoe UI" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
          </StackPanel>

          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight" VerticalAlignment="Center">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,6" Margin="6,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="DeviceDot" Width="8" Height="8" Fill="{StaticResource Bad}" Margin="0,0,7,0" />
                <TextBlock x:Name="HeaderDeviceState" Text="دستگاه قطع" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,6">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="{StaticResource Warn}" Margin="0,0,7,0" />
                <TextBlock x:Name="HeaderServerState" Text="سرور نامشخص" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="خانه" Click="ShowHome_Click" />
          <Button x:Name="NavCard" Style="{StaticResource NavButton}" Content="کارت" Click="ShowCard_Click" />
          <Button x:Name="NavTransactions" Style="{StaticResource NavButton}" Content="تراکنش‌ها" Click="ShowTransactions_Click" />
          <Button x:Name="NavTopup" Style="{StaticResource NavButton}" Content="شارژ اعتبار" Click="ShowTopup_Click" />
          <Button x:Name="NavSync" Style="{StaticResource NavButton}" Content="همگام‌سازی" Click="ShowSync_Click" />
          <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="تنظیمات" Click="ShowSettings_Click" />
          <Button x:Name="NavSupport" Style="{StaticResource NavButton}" Content="پشتیبانی" Click="ShowSupport_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Background="{StaticResource Bg}" BorderThickness="0" Padding="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </TabControl.Resources>

      <TabItem Header="Home">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
          <StackPanel Margin="28,24,28,30">
            <TextBlock Style="{StaticResource PageTitle}" Text="وضعیت کلی" />
            <TextBlock Style="{StaticResource MutedText}" Text="ارتباط دستگاه، صف همگام‌سازی و سرور در یک نگاه" Margin="0,0,0,18" />

            <UniformGrid Columns="3" Margin="0,0,0,16">
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource MutedText}" Text="وضعیت دستگاه" />
                  <TextBlock x:Name="HomeDeviceState" Text="در انتظار اتصال" FontFamily="IRANYekanX Bold, IRANYekanX, Segoe UI" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Warn}" Margin="0,12,0,0" />
                  <TextBlock x:Name="HomeDeviceSub" Text="-" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource MutedText}" Text="در انتظار ارسال" />
                  <TextBlock x:Name="PendingCountText" Text="0" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,10,0,0" />
                  <TextBlock Text="رویداد" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource MutedText}" Text="نیازمند بررسی" />
                  <TextBlock x:Name="ProblemCountText" Text="0" FontSize="34" FontWeight="Bold" Margin="0,10,0,0" />
                  <TextBlock Text="Conflict / Invalid" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="کد دستگاه" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="HomeDeviceCode" Grid.Column="1" Text="-" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="پورت دستگاه" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="HomePortText" Grid.Row="1" Grid.Column="1" Text="-" />
                  <TextBlock Grid.Row="2" Text="وضعیت سرور" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="HomeServerState" Grid.Row="2" Grid.Column="1" Text="نامشخص" />
                  <TextBlock Grid.Row="3" Text="HiMate Core" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="CoreVersionText" Grid.Row="3" Grid.Column="1" Text="-" />
                  <TextBlock Grid.Row="4" Text="آخرین همگام‌سازی" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="HomeLastSyncText" Grid.Row="4" Grid.Column="1" Text="-" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button Style="{StaticResource PrimaryButton}" Content="همگام‌سازی الآن" Click="SyncNow_Click" Margin="0,0,0,8" />
                  <TextBlock Text="اتصال دستگاه و سرور پس از ذخیره تنظیمات به‌صورت خودکار انجام می‌شود."
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="آخرین تراکنش" />
                <TextBlock x:Name="LastEventText" Text="هنوز رویدادی ثبت نشده است." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Card">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
          <StackPanel Margin="28,24,28,30">
            <TextBlock Style="{StaticResource PageTitle}" Text="کارت" />
            <TextBlock Style="{StaticResource MutedText}" Text="خواندن کارت بدون برداشت، مشاهده مالک و اتصال کارت به مشتری" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock x:Name="CardPromptText" Text="کارت را روی دستگاه قرار دهید." FontFamily="IRANYekanX Bold, IRANYekanX, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="CardDetailsText" Text="اطلاعات آخرین کارت پس از دریافت رویداد در این بخش نمایش داده می‌شود."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18" />
                <WrapPanel>
                  <Button Style="{StaticResource SecondaryButton}" Content="خواندن موجودی" Click="Balance_Click" Margin="0,0,8,0" />
                  <Button Style="{StaticResource SecondaryButton}" Content="وضعیت دستگاه" Click="Status_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="ثبت کارت برای مشتری" />
                <TextBlock Text="۱) کارت را بدون کسر اعتبار بخوانید." Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="AssignCardUidBox" Grid.Column="0" IsReadOnly="True" Text="" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="خواندن کارت بدون برداشت" Click="ReadCardForAssign_Click" />
                </Grid>
                <TextBlock x:Name="CardOwnerText" Text="مالک فعلی: -" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />

                <TextBlock Text="۲) مشتری را با نام، موبایل، ایمیل یا شناسه جستجو کنید." Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="CustomerSearchBox" Grid.Column="0" FlowDirection="RightToLeft" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="جستجو" Click="SearchCustomers_Click" />
                </Grid>

                <ComboBox x:Name="CustomerResultsBox"
                          DisplayMemberPath="DisplayLabel"
                          MinHeight="38"
                          Margin="0,0,0,14"
                          Foreground="{StaticResource Text}"
                          Background="{StaticResource Panel}">
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                      <Setter Property="Foreground" Value="{StaticResource Text}" />
                      <Setter Property="Background" Value="{StaticResource Panel}" />
                      <Setter Property="Padding" Value="10,8" />
                      <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                          <Setter Property="Background" Value="{StaticResource Line}" />
                          <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter Property="Background" Value="{StaticResource Accent}" />
                          <Setter Property="Foreground" Value="White" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </ComboBox.ItemContainerStyle>
                </ComboBox>

                <WrapPanel>
                  <Button Style="{StaticResource PrimaryButton}" Content="ثبت کارت برای مشتری" Click="AssignCard_Click" Width="190" Margin="0,0,8,0" />
                  <Button Style="{StaticResource SecondaryButton}" Content="قطع اتصال کارت" Click="UnassignCard_Click" Width="150" />
                </WrapPanel>
                <TextBlock x:Name="AssignmentFeedbackText" Text="" Foreground="{StaticResource Accent}" Margin="0,12,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="آخرین پاسخ دستگاه" />
                <TextBlock x:Name="LatestDeviceResponseText" Text="-" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Transactions">
        <Grid Background="{StaticResource Bg}" Margin="28,24,28,30">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="تراکنش‌ها" />
              <TextBlock Style="{StaticResource MutedText}" Text="رویدادهای ذخیره‌شده محلی و وضعیت همگام‌سازی آنها" />
            </StackPanel>
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Content="بروزرسانی" Click="RefreshTransactions_Click" />
          </Grid>

          <DataGrid x:Name="EventsGrid" Grid.Row="2" AlternationCount="2">
            <DataGrid.Columns>
              <DataGridTextColumn Header="زمان" Binding="{Binding ReceivedAtUtc}" Width="150" />
              <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="155" />
              <DataGridTextColumn Header="عملیات" Binding="{Binding Type}" Width="90" />
              <DataGridTextColumn Header="مقدار" Binding="{Binding Amount}" Width="75" />
              <DataGridTextColumn Header="مانده" Binding="{Binding Remaining}" Width="75" />
              <DataGridTextColumn Header="TX" Binding="{Binding Tx}" Width="65" />
              <DataGridTextColumn Header="GEN" Binding="{Binding Gen}" Width="85" />
              <DataGridTextColumn Header="SEQ" Binding="{Binding Seq}" Width="65" />
              <DataGridTextColumn Header="وضعیت" Binding="{Binding SyncStatus}" Width="110" />
              <DataGridTextColumn Header="خطا" Binding="{Binding LastError}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Topup">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
          <StackPanel Margin="28,24,28,30" MaxWidth="760" HorizontalAlignment="Right">
            <TextBlock Style="{StaticResource PageTitle}" Text="شارژ اعتبار" />
            <TextBlock Style="{StaticResource MutedText}" Text="شارژ دستی کارت از طریق دستگاه محلی" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="مبلغ شارژ" />
                <TextBox x:Name="TopupAmountBox" Text="1" Width="220" HorizontalAlignment="Right" FlowDirection="LeftToRight" TextAlignment="Right" />
                <TextBlock Text="پس از شروع، کارت موردنظر را روی دستگاه قرار دهید."
                           Foreground="{StaticResource Muted}" Margin="0,10,0,16" />
                <Button Style="{StaticResource PrimaryButton}" Content="شروع شارژ کارت" Click="StartTopup_Click" Width="220" HorizontalAlignment="Right" />
                <TextBlock x:Name="TopupFeedbackText" Text="" Foreground="{StaticResource Accent}" Margin="0,12,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="شارژ از سرور" />
                <TextBlock Text="اعمال خودکار دستور CREDIT سروری تا اضافه‌شدن تطبیق امن CID + UID در Firmware غیرفعال می‌ماند."
                           Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Sync">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
          <StackPanel Margin="28,24,28,30">
            <TextBlock Style="{StaticResource PageTitle}" Text="همگام‌سازی" />
            <TextBlock Style="{StaticResource MutedText}" Text="وضعیت صف محلی، سرور و درخواست‌های دریافتی" Margin="0,0,0,18" />

            <UniformGrid Columns="3" Margin="0,0,0,16">
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="وضعیت سرور" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="SyncServerStateText" Text="نامشخص" FontSize="22" FontWeight="Bold" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="در انتظار ارسال" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="SyncPendingText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="نیازمند بررسی" Foreground="{StaticResource Muted}" />
                  <TextBlock x:Name="SyncProblemText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
              <Button Style="{StaticResource PrimaryButton}" Content="همگام‌سازی الآن" Click="SyncNow_Click" Margin="0,0,8,0" />
              <Button Style="{StaticResource SecondaryButton}" Content="دریافت دستورات سرور" Click="RefreshCommands_Click" />
            </StackPanel>

            <DataGrid x:Name="CommandsGrid" Height="280">
              <DataGrid.Columns>
                <DataGridTextColumn Header="CID" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="100" />
                <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="170" />
                <DataGridTextColumn Header="مقدار" Binding="{Binding Amount}" Width="90" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
          <StackPanel Margin="28,24,28,30">
            <TextBlock Style="{StaticResource PageTitle}" Text="تنظیمات" />
            <TextBlock Style="{StaticResource MutedText}" Text="یک‌بار تنظیم کنید؛ HiMate Credit در اجراهای بعدی از همین تنظیمات استفاده می‌کند." Margin="0,0,0,18" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="دستگاه" />
                  <TextBlock Text="پورت COM" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComPortBox" Grid.Column="0" Margin="0,0,8,0" DropDownOpened="ComPortBox_DropDownOpened" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="بروزرسانی" Click="RefreshPorts_Click" />
                  </Grid>

                  <TextBlock Text="Baud Rate" Foreground="{StaticResource Muted}" Margin="0,14,0,6" />
                  <TextBox x:Name="BaudBox" Text="115200" FlowDirection="LeftToRight" TextAlignment="Left" />

                  <CheckBox x:Name="AutoConnectCheck" Content="اتصال خودکار در شروع برنامه" IsChecked="True" Margin="0,16,0,0" />

                  <Button Style="{StaticResource SecondaryButton}" Content="تست اتصال دستگاه" Click="TestDevice_Click" Margin="0,16,0,0" />
                  <TextBlock x:Name="DeviceTestFeedbackText" Text="" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="سرور" />
                  <TextBlock Text="Server URL" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                  <TextBox x:Name="ServerUrlBox" FlowDirection="LeftToRight" TextAlignment="Left" />

                  <TextBlock Text="Device Code" Foreground="{StaticResource Muted}" Margin="0,14,0,6" />
                  <TextBox x:Name="DeviceCodeBox" FlowDirection="LeftToRight" TextAlignment="Left" />

                  <TextBlock Text="Device Secret" Foreground="{StaticResource Muted}" Margin="0,14,0,6" />
                  <PasswordBox x:Name="DeviceSecretBox" FlowDirection="LeftToRight" />

                  <Button Style="{StaticResource SecondaryButton}" Content="تست اتصال سرور" Click="TestServer_Click" Margin="0,16,0,0" />
                  <TextBlock x:Name="ServerTestFeedbackText" Text="" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="برداشت پیش‌فرض" />
                  <TextBlock x:Name="CurrentDebitText" Text="مقدار فعلی دستگاه: -" Foreground="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBox x:Name="DefaultDebitBox" Text="1" FlowDirection="LeftToRight" TextAlignment="Left" />
                  <Button Style="{StaticResource SecondaryButton}" Content="ذخیره روی دستگاه" Click="SetDebit_Click" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="ذخیره تنظیمات" Click="SaveSettings_Click" Width="180" />
              <TextBlock x:Name="SettingsFeedbackText" Text="" Foreground="{StaticResource Accent}" Margin="14,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
              <Expander Header="ابزارهای سرویس و مدیریت پیشرفته" Foreground="{StaticResource Text}">
                <StackPanel Margin="0,14,0,0">
                  <TextBlock Text="این دستورات برای سرویس و عیب‌یابی هستند. عملیات پاک‌سازی با تأیید اجرا می‌شود."
                             Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,12" />
                  <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="MEMSTATUS" Click="MemStatus_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource SecondaryButton}" Content="SYNCLEDGER" Click="SyncLedger_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource SecondaryButton}" Content="REBOOT" Click="Reboot_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource DangerButton}" Content="RESET EVENT ID" Click="ResetEventId_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource DangerButton}" Content="CLEAR EVENTS" Click="ClearEvents_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource DangerButton}" Content="CLEAR RUNTIME" Click="ClearRuntime_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource DangerButton}" Content="CLEAR MEMORY" Click="ClearMemory_Click" Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Support">
        <Grid Background="{StaticResource Bg}" Margin="28,24,28,30">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="پشتیبانی" />
            <TextBlock Style="{StaticResource MutedText}" Text="وضعیت سریع و لاگ فنی HiMate Credit" />
          </StackPanel>

          <UniformGrid Grid.Row="2" Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="دستگاه" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="SupportDeviceText" Text="قطع" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="سرور" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="SupportServerText" Text="نامشخص" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="نسخه" Foreground="{StaticResource Muted}" />
                <TextBlock Text="0.2.4" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <ListBox x:Name="LogsList" Grid.Row="4" />
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{StaticResource Header}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="14,0">
        <TextBlock x:Name="BottomDeviceText" Text="دستگاه متصل نیست" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
        <TextBlock Text="نسخه 0.2.4" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left" />
      </Grid>
    </Border>
  </Grid>
</Window>
